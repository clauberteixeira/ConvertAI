{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ConvertAI",
  "version": "../package.json",
  "identifier": "io.github.clauberteixeira.convertai",
  "build": {
    "beforeBuildCommand": "node scripts/copy-web.mjs",
    "beforeDevCommand": "node scripts/copy-web.mjs",
    "frontendDist": "../dist/app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ConvertAÍ — imagens para PDF",
        "width": 900,
        "height": 780,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "appimage", "deb"],
    "shortDescription": "Imagens para PDF leve",
    "category": "Utility",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["PortugueseBR"]
      }
    },
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
